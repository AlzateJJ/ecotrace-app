PORT=3001
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Railway: set DATABASE_URL to the private PostgreSQL service reference.
DATABASE_URL=
# Only for local development without a PostgreSQL server. Never enabled in production.
DEV_EMBEDDED_DB=true
DEMO_MODE=true
# Production first administrator (created only when no users exist).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ORG_NAME=Mi organización
# Email verification codes. Mandatory in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EcoTrace <no-reply@example.com>
# Enable only if the PostgreSQL provider requires TLS; certificates are verified.
DATABASE_SSL=false
