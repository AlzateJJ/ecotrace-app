PORT=3001
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Railway: private PostgreSQL service reference. No email provider is required.
DATABASE_URL=
DEV_EMBEDDED_DB=true
DEMO_MODE=true
# Required in production: stable organization ID for all public registrations.
# Leave empty locally to use org-demo with demo data, or org-ecotrace without demo.
PUBLIC_REGISTRATION_ORG_ID=
BOOTSTRAP_ORG_NAME=EcoTrace
# Optional administrative account for managing sites and disabling accounts.
# Configure BOTH only in the deployment secrets; remove after the first startup.
# Public users register themselves; these are not their credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador
# Enable only if PostgreSQL requires TLS; certificates are verified.
DATABASE_SSL=false
