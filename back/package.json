    "pg": "^8.16.3",
    "@electric-sql/pglite": "^0.3.10",
    "dotenv": "^17.2.2",
    "nodemailer": "^10.6.1",
    "zod": "^4.1.5",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfkit": "^0.17.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
